# Velmorax | Produccion. Copia este archivo como .env.production.

APP_ENV=production

# Seguridad de sesion
SESSION_SECRET=GENERA_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
SESSION_MAX_AGE_SECONDS=2592000
SESSION_IDLE_TIMEOUT_MINUTES=90
SESSION_REMEMBER_IDLE_DAYS=14
SESSION_HTTPS_ONLY=1
SHOW_DEMO_ACCESS=0

# Base publica de la aplicacion
VELMORAX_DOMAIN=app.tu-dominio.com

# Base de datos
POSTGRES_DB=velmorax
POSTGRES_USER=velmorax
# Usa una clave larga alfanumerica; no incluyas @, :, /, # ni espacios.
POSTGRES_PASSWORD=GENERA_UNA_CLAVE_ALEATORIA_DE_32_CARACTERES
WEB_CONCURRENCY=2
SEED_DEMO_DATA=0

# Respaldo PostgreSQL cifrado y verificado
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION_DAYS=30
BACKUP_HEALTH_MAX_AGE_SECONDS=25200
# Opcional: destino configurado en .secrets/rclone.conf, por ejemplo s3:velmorax-clinica
BACKUP_REMOTE=

# Observabilidad (Grafana solo se publica en localhost del servidor)
LOG_LEVEL=INFO
MONITORING_RETENTION=30d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GENERA_UNA_CLAVE_DISTINTA_DE_32_CARACTERES
GRAFANA_PORT=3000

# Identidad legal y canal para consultas/reclamos de datos personales
LEGAL_COMPANY_NAME=RAZON_SOCIAL_DEL_PROVEEDOR
LEGAL_TAX_ID=NIT_DEL_PROVEEDOR
LEGAL_CONTACT_EMAIL=velmoradmin@gmail.com
LEGAL_CONTACT_ADDRESS=DIRECCION_Y_CIUDAD_DEL_PROVEEDOR

# Flujo por defecto
DEFAULT_ENTRY_FLOW=general

# Correo SMTP para recuperacion de clave
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USERNAME=velmoradmin@gmail.com
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_FROM_EMAIL=velmoradmin@gmail.com
SMTP_FROM_NAME=Velmorax

# SMS / verificacion de acceso
SMS_WEBHOOK_URL=
SMS_API_KEY=
SMS_SENDER_ID=Velmorax
