# Velmorax | Produccion

APP_ENV=production

# Seguridad de sesion
SESSION_SECRET=cambia-este-secreto-en-produccion
SESSION_MAX_AGE_SECONDS=2592000
SESSION_IDLE_TIMEOUT_MINUTES=90
SESSION_REMEMBER_IDLE_DAYS=14
SESSION_HTTPS_ONLY=1
SHOW_DEMO_ACCESS=0

# Base publica de la aplicacion
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Base de datos
DATABASE_URL=postgresql://velmorax:tu_clave@localhost:5432/velmorax
ALLOW_LOCAL_SQLITE_FALLBACK=1
DATABASE_FALLBACK_URL=sqlite:///data/velmorax.db

# Flujo por defecto
DEFAULT_ENTRY_FLOW=general

# Correo SMTP para recuperacion de clave
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USERNAME=soporte@tu-dominio-clinico.com
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_FROM_EMAIL=soporte@tu-dominio-clinico.com
SMTP_FROM_NAME=Velmorax

# SMS / verificacion de acceso
SMS_WEBHOOK_URL=
SMS_API_KEY=
SMS_SENDER_ID=Velmorax
