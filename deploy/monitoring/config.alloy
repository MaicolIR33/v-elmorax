logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "velmorax" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

discovery.relabel "velmorax" {
  targets = discovery.docker.velmorax.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "app|postgres|backup|caddy"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "velmorax" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.velmorax.output
  labels           = { platform = "velmorax" }
  forward_to       = [loki.process.velmorax.receiver]
  refresh_interval = "10s"
}

loki.process "velmorax" {
  stage.json {
    expressions = {
      event      = "event",
      level      = "level",
      request_id = "request_id",
    }
  }

  stage.labels {
    values = {
      event = "",
      level = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
